# 이 파일을 복사해서 application-local.yaml로 이름을 바꾸고, 실제 값을 채워 넣으세요.
# application-local.yaml은 .gitignore에 등록되어 있어 git에 올라가지 않습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/study_reservation?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: your_db_username
    password: your_db_password
    driver-class-name: com.mysql.cj.jdbc.Driver
